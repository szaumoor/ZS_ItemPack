BACKUP "weidu_external/backup/%MOD_FOLDER%"
SUPPORT "Find me at Gibberlings3, IE/G3 discord servers (or my own), or email me at: kaelyn@tuta.io"
VERSION "1.0.3"
README ~%MOD_FOLDER%/full_readme.md~
AUTO_EVAL_STRINGS
// MODDER
// 	setup_tra none
// 	area_variables warn
// 	missing_extern warn
// 	missing_resref warn
// 	ict2_actions warn
// 	missing_eval warn
// 	overwriting_file none
// 	fun_args warn
ALWAYS
	INCLUDE ~%MOD_FOLDER%/libs/zs_always.tph~
END
LANGUAGE
	"English"
	"english"
	"ZS_ItemPack/lang/english/setup.tra"
	~ZS_ItemPack/lang/english/Journal.tra~
	~ZS_ItemPack/lang/english/zsipakac.tra~
	~ZS_ItemPack/lang/english/zsipmum.tra~
	~ZS_ItemPack/lang/english/zsipbern.tra~

